# Machine-specific settings only. 
#
# Paths are resolved from this file's own location, so a copy of the project
# under any user's home or scratch works without editing.

_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_STAGE="$(cd "$_ENV_DIR/../.." && pwd)"

export RFD3_ALLOW_EXACT_ASU_MOTIF=1

# Prefer whatever the caller already exported, then the active conda env, then
# PATH. Avoids hardcoding one user's miniconda location.
export RFD3_EXE="${RFD3_EXE:-${CONDA_PREFIX:-/nonexistent}/bin/rfd3}"
if [ ! -x "$RFD3_EXE" ]; then export RFD3_EXE="$(command -v rfd3 || true)"; fi

# Checkpoint: override with CKPT=... or keep a copy under the stage root.
export CKPT="${CKPT:-$HOME/.foundry/checkpoints/rfd3_latest.ckpt}"
if [ ! -f "$CKPT" ] && [ -f "$_STAGE/checkpoints/rfd3_latest.ckpt" ]; then
    export CKPT="$_STAGE/checkpoints/rfd3_latest.ckpt"
fi

unset _ENV_DIR _STAGE

